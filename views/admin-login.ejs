<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Bizhub Admin Login</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Inter',sans-serif;
    }

    body{
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#0a0a0a;
      color:#fff;
      overflow:hidden;
      padding:20px;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 50% 90%, rgba(180, 60, 20, 0.25), transparent 60%),
        repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.02) 0 1px, transparent 1px 40px),
        repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.02) 0 1px, transparent 1px 40px);
      z-index: -2;
    }

    .login-card{
      width:100%;
      max-width:430px;
      background:#111;
      border:1px solid #222;
      border-radius:22px;
      padding:32px;
      box-shadow:0 20px 50px rgba(0,0,0,0.35);
    }

    .tag{
      display:inline-block;
      border:1px solid #3a2a1a;
      background:#1a0f00;
      color:#aaa;
      font-size:11px;
      font-weight:600;
      letter-spacing:3px;
      padding:6px 16px;
      border-radius:4px;
      margin-bottom:20px;
      text-transform:uppercase;
    }

    h1{
      font-size:30px;
      font-weight:800;
      margin-bottom:10px;
    }

    p{
      color:#888;
      font-size:14px;
      line-height:1.6;
      margin-bottom:22px;
    }

    .error{
      background:rgba(231,76,60,0.08);
      border:1px solid rgba(231,76,60,0.25);
      color:#e74c3c;
      font-size:13px;
      padding:12px 14px;
      border-radius:10px;
      margin-bottom:16px;
      display:flex;
      align-items:center;
      gap:8px;
    }

    .input-group{
      margin-bottom:14px;
    }

    .input-group input{
      width:100%;
      padding:14px 16px;
      border-radius:12px;
      border:1px solid #333;
      background:#0f0f0f;
      color:#fff;
      outline:none;
      font-size:14px;
    }

    .input-group input:focus{
      border-color:#E8541A;
    }

    .login-btn{
      width:100%;
      padding:14px;
      border:none;
      border-radius:12px;
      background:#E8541A;
      color:#fff;
      font-weight:700;
      cursor:pointer;
      font-size:15px;
      transition:0.25s;
      margin-top:6px;
    }

    .login-btn:hover{
      background:#ff6b2b;
    }
  </style>
</head>
<body>

  <form class="login-card" method="POST" action="/admin/login">
    <div class="tag">✦ Admin Access</div>
    <h1>Bizhub Admin Login</h1>
    <p>Only authorized Bizhub administrators can access the panel.</p>

    <!-- ✅ FIXED: Use `error` directly instead of `query.error` -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <div class="input-group">
      <input type="email" name="email" placeholder="Admin Email" required autocomplete="email">
    </div>

    <div class="input-group">
      <input type="password" name="password" placeholder="Admin Password" required autocomplete="current-password">
    </div>

    <button class="login-btn" type="submit">Login to Admin Panel</button>
  </form>

</body>
</html>