    /* ===== YOUTUBE SECTION ===== */
    .youtube-section {
      background: #0a0a0a;
      padding: 80px 0;
      font-family: 'Inter', sans-serif;
      overflow: hidden;
    }

    /* Header */
    .youtube-header {
      text-align: center;
      padding: 0 20px;
      margin-bottom: 60px;
    }

    .youtube-tag {
      display: inline-block;
      border: 1px solid #3a2a1a;
      background: #1a0a00;
      color: #aaa;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      padding: 5px 16px;
      border-radius: 4px;
      margin-bottom: 20px;
      text-transform: uppercase;
