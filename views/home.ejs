<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hero Landing</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', sans-serif;
    }

    body {
      background: #0a0a0a;
      color: white;
      overflow-x: hidden;
    }

    /* Background Effects */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 50% 90%, rgba(180, 60, 20, 0.25), transparent 60%),
        repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.02) 0 1px, transparent 1px 40px),
        repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.02) 0 1px, transparent 1px 40px);
      z-index: -2;
    }

    /* Dot grid */
    body::after {
      content: "";
      position: fixed;
      right: 10%;
      top: 20%;
      width: 200px;
      height: 200px;
      background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
      background-size: 14px 14px;
      opacity: 0.2;
      z-index: -1;
    }

    /* Navbar */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 60px;
    }

    .logo {
      font-weight: 600;
      /* border: 1px solid #555; */
      /* padding: 4px 10px; */
      width: 80px;
    }

    .logo img {
      height: 100%;
      width: 100%;
      object-fit: cover;
    }

    .nav-links {
      display: flex;
      gap: 20px;
      background: #1a1a1a;
      padding: 8px 18px;
      border-radius: 30px;
      border: 1px solid #333;
    }

    .nav-links a {
      text-decoration: none;
      color: #777;
      font-size: 14px;
    }

    .nav-links a.active {
      color: white;
    }

    .signin {
      color: white;
      text-decoration: none;
    }

    /* Hero */
    .hero {
      min-height: 90vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 20px;
      gap: 18px;
    }

    /* Tagline */
    .tagline {
      color: #E8541A;
      font-size: 14px;
      letter-spacing: 2px;
      font-weight: 600;
      opacity: 0;
      animation: fadeIn 1s forwards;
    }

    /* Headline */
    .headline {
      font-size: clamp(40px, 4vw, 80px);
      font-weight: 800;
      line-height: 1.2;
      opacity: 0;
      transform: translateY(30px);
      animation: slideUp 1s forwards;
      animation-delay: 0.3s;
    }

    .box {
      display: inline-block;
      border: 2px solid rgba(255, 255, 255, 0.4);
      padding: 2px 10px;
      margin: 0 5px;
    }

    /* Subtext */
    .subtext {
      color: #aaa;
      font-size: 18px;
      max-width: 600px;
      opacity: 0;
      animation: fadeIn 1s forwards;
      animation-delay: 0.6s;
    }

    /* Social proof */
    .social {
      display: flex;
      align-items: center;
      gap: 12px;
      opacity: 0;
      animation: fadeIn 1s forwards;
      animation-delay: 0.9s;
    }

    .avatars {
      display: flex;
    }

    .avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      margin-left: -10px;
    }

    .avatar:nth-child(1) {
      background: #e74c3c;
    }

    .avatar:nth-child(2) {
      background: #3498db;
    }

    .avatar:nth-child(3) {
      background: #2ecc71;
    }

    .avatar:nth-child(4) {
      background: #f39c12;
    }

    .social span.orange {
      color: #E8541A;
      font-weight: 600;
    }

    /* Button */
    .cta {
      padding: 16px 36px;
      background: linear-gradient(135deg, #E8541A, #C94A0F);
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      color: white;
      transition: 0.3s;
      opacity: 0;
      animation: fadeIn 1s forwards, pulse 2.5s infinite;
      animation-delay: 1.2s;
    }

    .cta:hover {
      transform: scale(1.04);
      box-shadow: 0 0 20px rgba(232, 84, 26, 0.7);
    }


    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');

    #page2 {
      padding: 0vw 5vw;
    }

    .bento-section {
      background: #0d0d0d;
      border: 1px solid #2a2a2a;
      border-radius: 20px;
      padding: 16px;
      font-family: 'Inter', sans-serif;
      color: white;
    }

    .bento-grid {
      display: grid;
      grid-template-columns: 55% 45%;
      gap: 12px;
    }

    /* Left side grid */
    .left-grid {
      display: grid;
      grid-template-rows: auto auto;
      gap: 12px;
    }

    .top-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    /* Card base */
    .card {
      background: #111;
      border: 1px solid #222;
      border-radius: 16px;
      padding: 24px;
    }

    /* Stat cards */
    .stat-title {
      font-size: 28px;
      font-weight: 800;
    }

    .stat-sub {
      color: #888;
      margin-top: 6px;
    }

    .stat-bottom {
      color: #777;
      font-size: 13px;
      margin-top: 18px;
    }

    /* CTA Card */
    .cta-card {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .cta-top {
      font-size: 32px;
      font-weight: 800;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .avatars {
      display: flex;
    }

    .avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      margin-left: -8px;
    }

    .avatar:nth-child(1) {
      background: #e74c3c;
    }

    .avatar:nth-child(2) {
      background: #3498db;
    }

    .avatar:nth-child(3) {
      background: #2ecc71;
    }

    .cta-bottom {
      font-size: 32px;
      font-weight: 800;
    }

    .arrow-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #444;
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 18px;
    }

    /* Right card */
    .video-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .video-box {
      border: 1px dashed #444;
      border-radius: 12px;
      height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #777;
      margin: 16px 0;
    }

    .video-box video {
      height: 100%;
      width: 100%;
      object-fit: cover;

    }

    .outline-btn {
      border: 1px solid #E8541A;
      color: #E8541A;
      border-radius: 999px;
      padding: 10px 18px;
      text-align: center;
      cursor: pointer;
      transition: 0.25s;
    }

    .outline-btn:hover {
      background: #E8541A;
      color: white;
    }


    #page3 {

      padding: 10px;
    }


    .logo-marquee {
      padding: 2.5rem 0;
      position: relative;
      background: #0a0a0a;
      border-top: 1px solid #1a1a1a;
      border-bottom: 1px solid #1a1a1a;
    }

    .logo-marquee--gradient {
      background-image:
        linear-gradient(90deg, #0a0a0a 5%, transparent 20%),
        linear-gradient(270deg, #0a0a0a 5%, transparent 20%);
      top: 0;
      height: 100%;
      left: 0;
      position: absolute;
      width: 100%;
      z-index: 1;
      pointer-events: none;
    }

    .logo-marquee--marquee {
      display: flex;
      overflow: hidden;
      user-select: none;
    }

    .logo-marquee--marquee-group {
      animation: scroll-left 30s linear infinite;
      display: flex;
      flex-shrink: 0;
      width: auto;
      align-items: center;
    }

    @media (prefers-reduced-motion) {
      .logo-marquee--marquee-group {
        animation-play-state: paused;
      }
    }

    .logo-marquee:hover .logo-marquee--marquee-group {
      animation-play-state: paused;
    }

    .logo-marquee--marquee-group .logo-item {
      height: 64px;
      padding: 0 50px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: 'Inter', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: #444;
      white-space: nowrap;
      transition: color 0.3s ease;
      cursor: default;
      letter-spacing: -0.5px;
    }

    .logo-marquee--marquee-group .logo-item:hover {
      color: #888;
    }

    .logo-marquee--marquee-group .logo-item .logo-accent {
      color: #E8541A;
      font-size: 18px;
    }

    .logo-marquee--marquee-group .logo-item .logo-small {
      font-size: 10px;
      font-weight: 600;
      color: #333;
      letter-spacing: 1px;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .logo-divider {
      color: #222;
      font-size: 28px;
      font-weight: 100;
      padding: 0;
      align-self: center;
    }

    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');

    .impact-section {
      background: #0a0a0a;
      padding: 80px 20px;
      overflow: hidden;
      font-family: 'Inter', sans-serif;
    }

    /* --- Header --- */
    .impact-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .impact-tag {
      display: inline-block;
      border: 1px solid #3a2a1a;
      background: #1a0f00;
      color: #aaa;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 3px;
      padding: 6px 18px;
      border-radius: 4px;
      margin-bottom: 20px;
      text-transform: uppercase;
    }

    .impact-title {
      font-size: clamp(32px, 5vw, 64px);
      font-weight: 800;
      color: #fff;
      line-height: 1.15;
      max-width: 800px;
      margin: 0 auto;
    }

    /* --- Cards Row --- */
    .impact-cards {
      display: flex;
      gap: 16px;
      align-items: stretch;
      min-height: 480px;
      transform: translateX(120px);
      opacity: 0;
      transition: transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        opacity 0.9s ease;
    }

    .impact-cards.animate-in {
      transform: translateX(0);
      opacity: 1;
    }

    /* --- Individual Card --- */
    .impact-card {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      flex: 1;
      min-width: 0;
      background: #111;
      border: 1px solid #222;
      cursor: pointer;
      min-height: 460px;
    }

    /* Image placeholder */
    .card-img-placeholder {
      width: 100%;
      height: 100%;
      min-height: 460px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: #333;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      position: absolute;
      top: 0;
      left: 0;
    }

    .card-img-placeholder img {
      height: 100%;
      width: 100%;
      object-fit: cover;
    }

    .placeholder-icon {
      font-size: 28px;
      opacity: 0.35;
    }

    /* Arrow button */
    .card-arrow {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
      background: #1a1a1a;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 16px;
      z-index: 10;
      text-decoration: none;
      transition: background 0.3s ease, transform 0.3s ease;
      border: 1px solid #2a2a2a;
    }

    .impact-card:hover .card-arrow {
      background: #E8541A;
      border-color: #E8541A;
      transform: scale(1.1);
    }

    /* Orange badge */
    .card-badge {
      position: absolute;
      top: 16px;
      left: 16px;
      background: #E8541A;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 50px;
      display: flex;
      align-items: center;
      gap: 6px;
      z-index: 10;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .impact-card:hover .card-badge {
      opacity: 1;
      transform: translateY(0);
    }

    /* --- Hover Overlay (hidden by default, shows on hover) --- */
    .card-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 28px 20px 24px;
      z-index: 5;
      /* Hidden state */
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.4s ease, transform 0.4s ease;
      background: linear-gradient(to top,
          rgba(180, 55, 10, 1) 0%,
          rgba(200, 70, 15, 0.92) 40%,
          rgba(220, 90, 20, 0.5) 75%,
          transparent 100%);
    }

    .impact-card:hover .card-overlay {
      opacity: 1;
      transform: translateY(0);
    }

    .card-overlay h3 {
      font-size: 20px;
      font-weight: 700;
      color: #fff;
      margin: 0 0 8px 0;
    }

    .card-overlay p {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.85);
      margin: 0;
      line-height: 1.6;
    }

    /* Subtle card hover lift */
    .impact-card {
      transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    }

    .impact-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 60px rgba(232, 84, 26, 0.18);
      border-color: #333;
    }

    /* Each card's unique overlay content */
    .card-1 .card-overlay {
      background: linear-gradient(to top,
          rgba(180, 55, 10, 1) 0%,
          rgba(200, 70, 15, 0.85) 50%,
          transparent 100%);
    }

    /* Staggered entrance */
    .impact-card:nth-child(1) {
      transition-delay: 0s;
    }

    .impact-card:nth-child(2) {
      transition-delay: 0.1s;
    }

    .impact-card:nth-child(3) {
      transition-delay: 0.2s;
    }

    .impact-card:nth-child(4) {
      transition-delay: 0.3s;
    }

    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');

    /* ===== COURSES SECTION ===== */
    .courses-section {
      background: #fdf0ec;
      padding: 80px 20px 0;
      font-family: 'Inter', sans-serif;
    }

    .courses-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .courses-tag {
      display: inline-block;
      border: 1px solid #c0795a;
      color: #333;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      padding: 5px 16px;
      border-radius: 4px;
      margin-bottom: 20px;
      text-transform: uppercase;
      background: transparent;
    }

    .courses-title {
      font-size: clamp(28px, 4vw, 52px);
      font-weight: 800;
      color: #111;
      line-height: 1.2;
      max-width: 700px;
      margin: 0 auto 30px;
    }

    .courses-explore-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #C94A0F;
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      padding: 14px 28px;
      border-radius: 50px;
      text-decoration: none;
      transition: background 0.3s ease, transform 0.3s ease;
    }

    .courses-explore-btn:hover {
      background: #E8541A;
      transform: scale(1.04);
    }

    /* ===== STICKY STACK WRAPPER ===== */
    .courses-stack {
      position: relative;
      max-width: 1100px;
      margin: 0 auto;
    }

    /* ===== EACH COURSE CARD ===== */
    .course-card {
      position: sticky;
      top: 80px;
      border-radius: 24px;
      overflow: hidden;
      margin-bottom: 24px;
      display: flex;
      flex-direction: row;
      align-items: stretch;
      min-height: 340px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);

      /* Scroll fade-in */
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .course-card.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Card color variants */
    .course-card.card-white {
      background: #ffffff;
    }

    .course-card.card-orange {
      background: #C94A0F;
    }

    .course-card.card-black {
      background: #111111;
    }

    /* ===== LEFT — Image Side ===== */
    .course-card .course-img {
      width: 42%;
      flex-shrink: 0;
      position: relative;
      overflow: hidden;
    }

    .course-card .course-img .img-placeholder {
      width: 100%;
      height: 100%;
      min-height: 340px;
      background: #1a1a1a;
      border: 2px dashed #2a2a2a;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: #444;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .course-card .course-img .img-placeholder {
      padding: 0;
      /* remove any default padding */
      border: none;
      /* remove dashed border when image is present */
    }

    .course-card .course-img .img-placeholder img {
      width: 100%;
      height: 100%;
      min-height: 340px;
      object-fit: cover;
      display: block;
    }

    .course-card.card-white .course-img .img-placeholder {
      background: #f0f0f0;
      border-color: #ddd;
      color: #aaa;
    }

    .course-card.card-orange .course-img .img-placeholder {
      background: #b8400d;
      border-color: #d05010;
      color: rgba(255, 255, 255, 0.4);
    }

    .img-placeholder .ph-icon {
      font-size: 32px;
      opacity: 0.4;
    }

    /* ===== RIGHT — Content Side ===== */
    .course-card .course-info {
      flex: 1;
      padding: 40px 44px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 16px;
    }

    .course-info h2 {
      font-size: clamp(22px, 2.5vw, 34px);
      font-weight: 900;
      line-height: 1.2;
      margin: 0;
    }

    .course-card.card-white .course-info h2 {
      color: #111;
    }

    .course-card.card-orange .course-info h2 {
      color: #fff;
    }

    .course-card.card-black .course-info h2 {
      color: #fff;
    }

    .course-info p {
      font-size: 14px;
      line-height: 1.6;
      margin: 0;
    }

    .course-card.card-white .course-info p {
      color: #666;
    }

    .course-card.card-orange .course-info p {
      color: rgba(255, 255, 255, 0.8);
    }

    .course-card.card-black .course-info p {
      color: #888;
    }

    /* ===== Meta tags row ===== */
    .course-meta {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 600;
    }

    .meta-item .meta-icon {
      font-size: 14px;
    }

    .meta-item .meta-label {
      font-size: 10px;
      font-weight: 400;
      display: block;
      opacity: 0.7;
    }

    .course-card.card-white .meta-item {
      background: #f5f5f5;
      color: #333;
    }

    .course-card.card-orange .meta-item {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
    }

    .course-card.card-black .meta-item {
      background: #222;
      color: #fff;
    }

    /* ===== Price row ===== */
    .course-price {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .price-label {
      font-size: 20px;
      font-weight: 700;
    }

    .price-current {
      font-size: 28px;
      font-weight: 900;
      color: #E8541A;
    }

    .course-card.card-orange .price-current {
      color: #fff;
    }

    .price-original {
      font-size: 13px;
      text-decoration: line-through;
      opacity: 0.5;
    }

    .course-card.card-white .price-label {
      color: #111;
    }

    .course-card.card-orange .price-label {
      color: #fff;
    }

    .course-card.card-black .price-label {
      color: #fff;
    }

    .course-card.card-white .price-original {
      color: #666;
    }

    .course-card.card-orange .price-original {
      color: rgba(255, 255, 255, 0.6);
    }

    .course-card.card-black .price-original {
      color: #666;
    }

    /* ===== CTA Button ===== */
    .course-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      width: fit-content;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .course-btn:hover {
      transform: scale(1.04);
      opacity: 0.9;
    }

    .course-card.card-white .course-btn {
      background: #111;
      color: #fff;
    }

    .course-card.card-orange .course-btn {
      background: #fff;
      color: #C94A0F;
    }

    .course-card.card-black .course-btn {
      background: #E8541A;
      color: #fff;
    }

    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');

    /* ===== TESTIMONIALS SECTION ===== */
    .testimonials-section {
      background: #0a0a0a;
      padding: 80px 0;
      font-family: 'Inter', sans-serif;
      overflow: hidden;
    }

    /* Header */
    .testimonials-header {
      text-align: center;
      padding: 0 20px;
      margin-bottom: 60px;
    }

    .testimonials-tag {
      display: inline-block;
      border: 1px solid #3a2a1a;
      background: transparent;
      color: #aaa;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      padding: 5px 16px;
      border-radius: 4px;
      margin-bottom: 20px;
      text-transform: uppercase;
    }

    .testimonials-title {
      font-size: clamp(28px, 4vw, 54px);
      font-weight: 800;
      color: #fff;
      line-height: 1.2;
      max-width: 700px;
      margin: 0 auto;
    }

    /* ===== MARQUEE WRAPPER ===== */
    .marquee-wrapper {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Each row */
    .marquee-row {
      display: flex;
      overflow: hidden;
      user-select: none;
      width: 100%;
      position: relative;
    }

    /* Fade edges */
    .marquee-row::before,
    .marquee-row::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 2;
      pointer-events: none;
    }

    .marquee-row::before {
      left: 0;
      background: linear-gradient(90deg, #0a0a0a 0%, transparent 100%);
    }

    .marquee-row::after {
      right: 0;
      background: linear-gradient(270deg, #0a0a0a 0%, transparent 100%);
    }

    /* Marquee track */
    .marquee-track {
      display: flex;
      gap: 20px;
      flex-shrink: 0;
      width: max-content;
    }

    /* Row 1 — Right to Left */
    .marquee-row-1 .marquee-track {
      animation: scroll-rtl 35s linear infinite;
    }

    /* Row 2 — Left to Right */
    .marquee-row-2 .marquee-track {
      animation: scroll-ltr 35s linear infinite;
    }

    /* Pause on hover */
    .marquee-row:hover .marquee-track {
      animation-play-state: paused;
    }

    /* ===== FAQ SECTION ===== */
    .faq-section {
     
      background: #0a0a0a;
      padding: 80px 20px;
      font-family: 'Inter', sans-serif;
    }

    /* Header */
    .faq-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .faq-tag {
      display: inline-block;
      border: 1px solid #3a2a1a;
      background: transparent;
      color: #aaa;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      padding: 5px 16px;
      border-radius: 4px;
      margin-bottom: 20px;
      text-transform: uppercase;
    }

    .faq-title {
      font-size: clamp(28px, 4vw, 52px);
      font-weight: 800;
      color: #fff;
      line-height: 1.2;
      max-width: 650px;
      margin: 0 auto;
    }

    /* ===== FAQ LIST ===== */
    .faq-list {
      max-width: 680px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
       height: 100vh;
       margin-top: 3vw;
    }

    /* ===== EACH FAQ ITEM ===== */
    .faq-item {
      background: #111;
      border: 1px solid #1f1f1f;
      border-radius: 14px;
      overflow: hidden;
      transition: border-color 0.3s ease;
    }

    .faq-item.open {
      border-color: #E8541A;
    }

    /* Question row */
    .faq-question {
      width: 100%;
      background: transparent;
      border: none;
      padding: 22px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      cursor: pointer;
      text-align: left;
    }

    .faq-question-text {
      font-size: 15px;
      font-weight: 600;
      color: #fff;
      line-height: 1.4;
      flex: 1;
      transition: color 0.3s ease;
    }

    .faq-item.open .faq-question-text {
      color: #fff;
    }

    /* Icon */
    .faq-icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1px solid #2a2a2a;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.3s ease,
        border-color 0.3s ease,
        transform 0.4s ease;
      color: #aaa;
      font-size: 16px;
      font-weight: 300;
    }

    .faq-item.open .faq-icon {
      background: #E8541A;
      border-color: #E8541A;
      color: #fff;
      transform: rotate(180deg);
    }

    /* Answer */
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
        padding 0.3s ease;
      padding: 0 24px;
    }

    .faq-item.open .faq-answer {
      max-height: 300px;
      padding: 0 24px 22px;
    }

    .faq-answer-inner {
      border-top: 1px solid #1f1f1f;
      padding-top: 16px;
    }

    .faq-answer p {
      font-size: 13px;
      color: #777;
      line-height: 1.8;
      margin: 0;
    }

    /* Hover on closed items */
    .faq-item:not(.open):hover {
      border-color: #2a2a2a;
    }

    .faq-item:not(.open):hover .faq-question-text {
      color: #ddd;
    }

    .faq-item:not(.open):hover .faq-icon {
      border-color: #444;
      color: #ccc;
    }

    /* Scroll fade-in */
    .faq-item {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease,
        transform 0.5s ease,
        border-color 0.3s ease;
    }

    .faq-item.fade-in {
      opacity: 1;
      transform: translateY(0);
    }

    /* Stagger delays */
    .faq-item:nth-child(1) {
      transition-delay: 0s;
    }

    .faq-item:nth-child(2) {
      transition-delay: 0.08s;
    }

    .faq-item:nth-child(3) {
      transition-delay: 0.16s;
    }

    .faq-item:nth-child(4) {
      transition-delay: 0.24s;
    }

    .faq-item:nth-child(5) {
      transition-delay: 0.32s;
    }

    .faq-item:nth-child(6) {
      transition-delay: 0.40s;
    }

    /* ── FOOTER ─────────────────────────────────────────────── */
    .footer {
      position: relative;
      background: #000;
      overflow: hidden;
      padding-bottom: 60px;
    }

    /* ── GIANT BACKGROUND "Sheryians" TEXT ──────────────────── */
    .footer__bg-text {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
      font-size: clamp(80px, 15vw, 200px);
      font-weight: 900;
      letter-spacing: -4px;
      line-height: 1;
      pointer-events: none;
      user-select: none;
    }

    .footer__bg-text span {
      display: inline-block;
      color: transparent;
      -webkit-text-stroke: 1px rgba(255, 255, 255, 0.12);
      transition: color 0.3s ease, text-shadow 0.3s ease, -webkit-text-stroke 0.3s ease;
      pointer-events: all;
      cursor: default;
    }

    /* Hover: orange glow effect on each letter */
    .footer__bg-text:hover span {
      color: #c0392b;
      -webkit-text-stroke: 1px transparent;
      text-shadow:
        0 0 20px rgba(230, 90, 20, 0.9),
        0 0 50px rgba(230, 90, 20, 0.6),
        0 0 100px rgba(230, 90, 20, 0.3);
    }

    /* Individual letter hover for per-letter glow */
    .footer__bg-text span:hover {
      color: #e85d20 !important;
      -webkit-text-stroke: 1px transparent !important;
      text-shadow:
        0 0 10px rgba(255, 120, 30, 1),
        0 0 40px rgba(230, 90, 20, 0.9),
        0 0 80px rgba(200, 60, 10, 0.6),
        0 0 120px rgba(180, 40, 5, 0.3) !important;
      transform: scale(1.05);
      transition: all 0.2s ease;
    }

    /* ── FOOTER CONTENT (sits below the big text) ───────────── */
    .footer__content {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: clamp(160px, 18vw, 260px) 60px 0 60px;
      gap: 40px;
    }

    /* ── LEFT: Logo + Socials ───────────────────────────────── */
    .footer__left {
      display: flex;
      flex-direction: column;
      gap: 24px;
      min-width: 120px;
    }

    .logo-box {
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logo-box img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }

    .footer__socials {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .footer__socials a {
      color: rgba(255, 255, 255, 0.6);
      font-size: 20px;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .footer__socials a:hover {
      color: #e85d20;
    }

    /* ── NAV COLUMNS ─────────────────────────────────────────── */
    .footer__nav {
      display: flex;
      gap: clamp(40px, 6vw, 100px);
      flex-wrap: wrap;
    }

    .footer__col h4 {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #fff;
      margin-bottom: 20px;
    }

    .footer__col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .footer__col ul li a,
    .footer__col p,
    .footer__col a {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.55);
      text-decoration: none;
      transition: color 0.2s ease;
      line-height: 1.5;
    }

    .footer__col ul li a:hover,
    .footer__col a:hover {
      color: #e85d20;
    }

    .footer__col p {
      margin-bottom: 4px;
    }

    .footer__col p strong {
      color: #fff;
      font-weight: 600;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .faq-question-text {
        font-size: 14px;
      }

      .faq-question {
        padding: 18px 18px;
      }

      .faq-answer {
        padding: 0 18px;
      }

      .faq-item.open .faq-answer {
        padding: 0 18px 18px;
      }
    }

    @keyframes scroll-rtl {
      0% {
        transform: translateX(0);
      }

      100% {
        transform: translateX(-50%);
      }
    }

    @keyframes scroll-ltr {
      0% {
        transform: translateX(-50%);
      }

      100% {
        transform: translateX(0);
      }
    }

    @media (prefers-reduced-motion) {
