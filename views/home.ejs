    /* ===== SCROLLING TRACK ===== */
    .youtube-track-wrapper {
      position: relative;
      width: 100%;
      overflow: hidden;
    }

    /* Fade edges */
    .youtube-track-wrapper::before,
    .youtube-track-wrapper::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 180px;
      z-index: 2;
      pointer-events: none;
    }

