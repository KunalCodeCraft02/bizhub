<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bizhub Mentorship</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: radial-gradient(circle at 50% 90%, rgba(180, 60, 20, 0.25), transparent 60%),
                repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.015) 0 1px, transparent 1px 40px),
                #0a0a0a;
            color: white;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .container {
            width: min(1200px, 92%);
            margin: auto;
        }

        .navbar {
            width: 100%;
            padding: 22px 6%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 999;
            backdrop-filter: blur(18px);
            background: rgba(10, 10, 10, 0.75);
            border-bottom: 1px solid #1a1a1a;
        }

        .logo {
            font-size: 32px;
            font-weight: 900;
        }

        .logo span {
            color: #E8541A;
        }

        .nav-links {
            display: flex;
            gap: 30px;
        }

        .nav-links a {
            color: #8c8c8c;
            text-decoration: none;
            transition: 0.3s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: white;
        }

        .signin-btn {
            padding: 12px 24px;
            border-radius: 999px;
            background: linear-gradient(135deg, #E8541A, #C94A0F);
            color: white;
            text-decoration: none;
            font-weight: 700;
        }

        section {
            padding: 80px 0;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 10px 22px;
            border-radius: 999px;
            border: 1px solid #3a2a1a;
            background: #1a0f00;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 12px;
        }

        .section-head {
            margin-bottom: 50px;
            text-align: center;
        }

        .section-head h2 {
            font-size: clamp(32px, 5vw, 56px);
            font-weight: 800;
            line-height: 1.1;
            margin-top: 22px;
        }

        .section-head p {
            color: #888;
            margin-top: 16px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .status-banner {
            max-width: 800px;
            margin: 60px auto;
            padding: 40px;
            border-radius: 20px;
            text-align: center;
        }

        .status-banner.pending {
            background: rgba(255, 215, 0, 0.08);
            border: 1px solid rgba(255, 215, 0, 0.3);
        }

        .status-banner.approved {
            background: rgba(46, 204, 113, 0.08);
            border: 1px solid rgba(46, 204, 113, 0.3);
        }

        .status-banner.rejected {
            background: rgba(231, 76, 60, 0.08);
            border: 1px solid rgba(231, 76, 60, 0.3);
        }

        .status-banner .icon {
            font-size: 56px;
            margin-bottom: 20px;
        }

        .status-banner h2 {
            font-size: 28px;
            margin-bottom: 14px;
            font-weight: 800;
        }

        .status-banner p {
            color: #aaa;
            line-height: 1.7;
            font-size: 15px;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }

        .profile-card {
            background: #111;
            border: 1px solid #222;
            border-radius: 16px;
            padding: 24px;
            transition: 0.4s ease;
            position: relative;
        }

        .profile-card:hover {
            border-color: #E8541A;
            transform: translateY(-6px);
            box-shadow: 0 24px 60px rgba(232, 84, 26, 0.18);
        }

        .card-photo {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: linear-gradient(135deg, #E8541A, #C94A0F);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 800;
            color: white;
            margin-bottom: 16px;
        }

        .card-name {
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .card-role {
            color: #8d8d8d;
            font-size: 13px;
            margin-bottom: 14px;
        }

        .sector-tag {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 999px;
            background: #1a0f00;
            border: 1px solid #3a2a1a;
            color: #E8541A;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .card-bio {
            color: #888;
            font-size: 13px;
            line-height: 1.7;
            margin: 14px 0;
            padding-top: 14px;
            border-top: 1px solid #222;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .know-more-btn,
        .connect-btn {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid #E8541A;
            background: transparent;
            color: #E8541A;
            font-weight: 700;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 12px;
            font-size: 14px;
        }

        .know-more-btn:hover,
        .connect-btn:hover {
            background: #E8541A;
            color: white;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-box {
            background: #111;
            border: 1px solid #333;
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            width: 100%;
            position: relative;
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from {
                transform: translateY(20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .modal-close {
            position: absolute;
            top: 16px;
            right: 16px;
            background: #1a1a1a;
            border: none;
            color: white;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 16px;
        }

        .modal-photo {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: linear-gradient(135deg, #E8541A, #C94A0F);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            font-weight: 800;
            color: white;
            margin: 0 auto 20px;
        }

        .modal-name {
            text-align: center;
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .modal-role {
            text-align: center;
            color: #888;
            font-size: 13px;
            margin-bottom: 24px;
        }

        .modal-info {
            padding: 14px 0;
            border-bottom: 1px solid #222;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .modal-info:last-child {
            border-bottom: none;
        }

        .modal-info i {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: rgba(232, 84, 26, 0.1);
            color: #E8541A;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .modal-info .label {
            color: #888;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .modal-info .value {
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            word-break: break-all;
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
            color: #888;
            background: #0d0d0d;
            border: 1px dashed #222;
            border-radius: 20px;
            margin-top: 40px;
        }

        .empty-state i {
            font-size: 56px;
            opacity: 0.2;
            margin-bottom: 20px;
            display: block;
        }

        .empty-state h3 {
            color: #ccc;
            font-size: 22px;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .empty-state p {
            font-size: 14px;
            line-height: 1.7;
        }

        .info-box {
            background: rgba(232, 84, 26, 0.08);
            border: 1px solid rgba(232, 84, 26, 0.25);
            border-radius: 14px;
            padding: 20px 24px;
            margin-bottom: 30px;
            color: #ddd;
            font-size: 14px;
            line-height: 1.7;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .info-box i {
            color: #E8541A;
            font-size: 24px;
            flex-shrink: 0;
        }

        @media(max-width:768px) {
            .nav-links {
                display: none;
            }

            .cards-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="logo">Biz<span>hub</span></div>
        <div class="nav-links">
            <a href="/">Home</a>
            <% if (viewType==='student' ) { %>
                <a href="/courseplayer">Courses</a>
                <a href="/leaderboard">Leaderboard</a>
                <% } %>
                    <a href="/mentorship" class="active">Mentorship</a>
        </div>
        <% if (viewType==='mentor' ) { %>
            <a href="/mentorlogout" class="signin-btn">Logout</a>
            <% } else if (viewType==='student' ) { %>
                <a href="/logout" class="signin-btn">Logout</a>
                <% } else { %>
                    <a href="/signinas" class="signin-btn">Sign In</a>
                    <% } %>
    </nav>

    <!-- ========== MENTOR VIEW ========== -->
    <% if (viewType==='mentor' ) { %>

        <% if (mentor.applicationStatus==='pending' ) { %>
            <section>
                <div class="container">
                    <div class="status-banner pending">
                        <div class="icon">⏳</div>
                        <h2>Application Under Review</h2>
                        <p>
                            Hello <strong style="color:#FFD700">
                                <%= mentor.firstName %>
                            </strong>!
                            Your mentor application is currently being reviewed by the Bizhub admin team.
                            <br><br>
                            We'll notify you once your profile is approved. This typically takes <strong>1-3 business
                                days</strong>.
                            <br><br>
                            <small style="color:#888;">Application submitted with email: <%= mentor.email %></small>
                        </p>
                    </div>
                </div>
            </section>
            <% } %>

                <% if (mentor.applicationStatus==='rejected' ) { %>
                    <section>
                        <div class="container">
                            <div class="status-banner rejected">
                                <div class="icon">❌</div>
                                <h2>Application Not Approved</h2>
                                <p>
                                    Hello <strong style="color:#e74c3c">
                                        <%= mentor.firstName %>
                                    </strong>,
                                    unfortunately your mentor application has not been approved at this time.
                                    <% if (mentor.rejectionReason) { %>
                                        <br><br><strong>Reason:</strong>
                                        <%= mentor.rejectionReason %>
                                            <% } %>
                                                <br><br>
                                                You can contact <a href="mailto:hello@bizhub.com"
                                                    style="color:#E8541A;">hello@bizhub.com</a> for more information.
                                </p>
                            </div>
                        </div>
                    </section>
                    <% } %>

                        <% if (mentor.applicationStatus==='approved' ) { %>
                            <section>
                                <div class="container">
                                    <div class="status-banner approved">
                                        <div class="icon">🎉</div>
                                        <h2>Congratulations <%= mentor.firstName %>!</h2>
                                        <p>
                                            <strong style="color:#2ecc71;">Your journey as a Bizhub Mentor starts right
                                                away!</strong>
                                            <br><br>
                                            You've been assigned to mentor students in the
                                            <strong style="color:#E8541A">
                                                <%= mentor.sector || 'Not Assigned' %>
                                            </strong> sector.
                                            Below are the students you can connect with and guide.
                                        </p>
                                    </div>

                                    <div class="section-head">
                                        <div class="tag">✦ YOUR STUDENTS</div>
                                        <h2>Students Awaiting Your Mentorship</h2>
                                        <p>Click "Know More" to view contact details and reach out to your mentees.</p>
                                    </div>

                                    <% if (mentor.sector) { %>
                                        <div class="info-box">
                                            <i class="fas fa-tag"></i>
                                            <div>
                                                Showing students matched to your sector: <strong style="color:#E8541A">
                                                    <%= mentor.sector %>
                                                </strong>
                                                <br><small style="color:#888">Total matched students: <%=
                                                        matchedStudents.length %></small>
                                            </div>
                                        </div>
                                        <% } %>

                                            <% if (matchedStudents && matchedStudents.length> 0) { %>
                                                <div class="cards-grid">
                                                    <% matchedStudents.forEach(function(student) { %>
                                                        <div class="profile-card">
                                                            <div class="card-photo">
                                                                <%= (student.firstName || 'S' ).charAt(0).toUpperCase()
                                                                    %>
                                                                    <%= (student.lastName || ''
                                                                        ).charAt(0).toUpperCase() %>
                                                            </div>
                                                            <div class="card-name">
                                                                <%= student.firstName %>
                                                                    <%= student.lastName %>
                                                            </div>
                                                            <div class="card-role">📚 Student • <%= student.collegeName
                                                                    || 'No college' %>
                                                            </div>
                                                            <div class="sector-tag">
                                                                <%= student.detectedSector %>
                                                            </div>

                                                            <button class="know-more-btn js-student-btn"
                                                                data-name="<%= student.firstName %> <%= student.lastName %>"
                                                                data-college="<%= student.collegeName || '-' %>"
                                                                data-contact="<%= student.mobileNumber || '-' %>"
                                                                data-email="<%= student.email %>"
                                                                data-sector="<%= student.detectedSector %>">
                                                                Know More <i class="fas fa-arrow-right"></i>
                                                            </button>
                                                        </div>
                                                        <% }); %>
                                                </div>
                                                <% } else { %>
                                                    <div class="empty-state">
                                                        <i class="fas fa-users-slash"></i>
                                                        <h3>No Students Matched Yet</h3>
                                                        <p>
                                                            Students will appear here once the admin assigns them to
                                                            your sector.
                                                            <br>Your assigned sector: <strong style="color:#E8541A;">
                                                                <%= mentor.sector || 'Not Set' %>
                                                            </strong>
                                                        </p>
                                                    </div>
                                                    <% } %>
                                </div>
                            </section>
                            <% } %>

                                <% } %>

                                    <!-- ========== STUDENT VIEW ========== -->
                                    <% if (viewType==='student' ) { %>
                                        <section>
                                            <div class="container">
                                                <div class="section-head">
                                                    <div class="tag">✦ YOUR MENTORS</div>
                                                    <h2>Find Mentors For Your Journey</h2>
                                                    <p>Connect with industry experts matched to your startup sector.</p>
                                                </div>

                                                <% if (student.sector) { %>
                                                    <div class="info-box">
                                                        <i class="fas fa-bullseye"></i>
                                                        <div>
                                                            Showing mentors matched to your sector: <strong
                                                                style="color:#E8541A">
                                                                <%= student.sector %>
                                                            </strong>
                                                            <br><small style="color:#888">Total matched mentors: <%=
                                                                    matchedMentors.length %></small>
                                                        </div>
                                                    </div>

                                                    <% if (matchedMentors && matchedMentors.length> 0) { %>
                                                        <div class="cards-grid">
                                                            <% matchedMentors.forEach(function(m) { %>
                                                                <div class="profile-card">
                                                                    <div class="card-photo">
                                                                        <%= m.firstName.charAt(0).toUpperCase() %>
                                                                            <%= m.lastName.charAt(0).toUpperCase() %>
                                                                    </div>
                                                                    <div class="card-name">
                                                                        <%= m.firstName %>
                                                                            <%= m.lastName %>
                                                                    </div>
                                                                    <div class="card-role">🎓 <%= m.expertise %>
                                                                    </div>
                                                                    <div class="sector-tag">
                                                                        <%= m.sector %>
                                                                    </div>
                                                                    <div class="card-bio">
                                                                        <%= m.bio %>
                                                                    </div>

                                                                    <button class="know-more-btn js-mentor-btn"
                                                                        data-name="<%= m.firstName %> <%= m.lastName %>"
                                                                        data-email="<%= m.email %>"
                                                                        data-contact="<%= m.mobile %>"
                                                                        data-sector="<%= m.sector %>"
                                                                        data-expertise="<%= m.expertise %>"
                                                                        data-experience="<%= m.experience %>"
                                                                        data-bio="<%= m.bio %>">
                                                                        Know More <i class="fas fa-arrow-right"></i>
                                                                    </button>
                                                                </div>
                                                                <% }); %>
                                                        </div>
                                                        <% } else { %>
                                                            <div class="empty-state">
                                                                <i class="fas fa-user-slash"></i>
                                                                <h3>No Mentors Available Yet</h3>
                                                                <p>
                                                                    No mentors found for your sector: <strong
                                                                        style="color:#E8541A;">
                                                                        <%= student.sector %>
                                                                    </strong>
                                                                    <br><br>Check back soon — new mentors join Bizhub
                                                                    every week!
                                                                </p>
                                                            </div>
                                                            <% } %>
                                                                <% } else { %>
                                                                    <div class="empty-state">
                                                                        <i class="fas fa-clock"></i>
                                                                        <h3>Your Sector Hasn't Been Assigned Yet</h3>
                                                                        <p>
                                                                            Submit your Idea Document, Business Model
                                                                            Canvas, or Pitch Deck in the
                                                                            <a href="/courseplayer"
                                                                                style="color:#E8541A;">Course Player</a>
                                                                            and wait for the admin to assign your
                                                                            startup sector.
                                                                            <br><br>Once assigned, matched mentors will
                                                                            appear here!
                                                                        </p>
                                                                    </div>
                                                                    <% } %>
                                            </div>
                                        </section>
                                        <% } %>

                                            <!-- ========== GUEST VIEW ========== -->
                                            <% if (viewType==='guest' ) { %>
                                                <section>
                                                    <div class="container"
                                                        style="text-align:center; padding-top: 60px;">
                                                        <div class="tag">✦ MENTORSHIP</div>
                                                        <h1
                                                            style="font-size:clamp(42px,7vw,72px); font-weight:900; margin:28px 0;">
                                                            Learn From Those<br>Who've Built It
                                                        </h1>
                                                        <p
                                                            style="max-width:760px; margin:auto; color:#8d8d8d; line-height:1.8; font-size:18px;">
                                                            Connect with verified startup founders and industry experts
                                                            who guide you from idea to launch.
                                                        </p>
                                                        <div
                                                            style="margin-top:40px; display:flex; justify-content:center; gap:18px; flex-wrap:wrap;">
                                                            <a href="/login" class="signin-btn">Login as Student</a>
                                                            <a href="/mentorlogin" class="signin-btn"
                                                                style="background:transparent; border:1px solid #E8541A; color:#E8541A;">Login
                                                                as Mentor</a>
                                                            <a href="/mentorsignup" class="signin-btn"
                                                                style="background:transparent; border:1px solid #E8541A; color:#E8541A;">Become
                                                                a Mentor</a>
                                                        </div>
                                                    </div>

                                                    <% if (mentors && mentors.length> 0) { %>
                                                        <div class="container" style="margin-top: 100px;">
                                                            <div class="section-head">
                                                                <div class="tag">✦ OUR MENTORS</div>
                                                                <h2>Meet The People Backing Your Vision</h2>
                                                            </div>
                                                            <div class="cards-grid">
                                                                <% mentors.forEach(function(m) { %>
                                                                    <div class="profile-card">
                                                                        <div class="card-photo">
                                                                            <%= m.firstName.charAt(0).toUpperCase() %>
                                                                                <%= m.lastName.charAt(0).toUpperCase()
                                                                                    %>
                                                                        </div>
                                                                        <div class="card-name">
                                                                            <%= m.firstName %>
                                                                                <%= m.lastName %>
                                                                        </div>
                                                                        <div class="card-role">
                                                                            <%= m.expertise %>
                                                                        </div>
                                                                        <% if (m.sector) { %>
                                                                            <div class="sector-tag">
                                                                                <%= m.sector %>
                                                                            </div>
                                                                            <% } %>
                                                                                <div class="card-bio">
                                                                                    <%= m.bio %>
                                                                                </div>
                                                                                <a href="/login" class="connect-btn"
                                                                                    style="display:block; text-align:center; text-decoration:none;">
                                                                                    Login to Connect →
                                                                                </a>
                                                                    </div>
                                                                    <% }); %>
                                                            </div>
                                                        </div>
                                                        <% } %>
                                                </section>
                                                <% } %>

                                                    <!-- STUDENT MODAL -->
                                                    <div class="modal-overlay" id="studentModal">
                                                        <div class="modal-box">
                                                            <button class="modal-close"
                                                                onclick="closeModal('studentModal')">✕</button>
                                                            <div class="modal-photo" id="studentInitials">S</div>
                                                            <div class="modal-name" id="studentName">—</div>
                                                            <div class="modal-role">Bizhub Student</div>

                                                            <div class="modal-info">
                                                                <i class="fas fa-school"></i>
                                                                <div>
                                                                    <div class="label">School / College</div>
                                                                    <div class="value" id="studentCollege">—</div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-info">
                                                                <i class="fas fa-phone"></i>
                                                                <div>
                                                                    <div class="label">Contact Number</div>
                                                                    <div class="value" id="studentContact">—</div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-info">
                                                                <i class="fas fa-envelope"></i>
                                                                <div>
                                                                    <div class="label">Email Address</div>
                                                                    <div class="value" id="studentEmail">—</div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-info">
                                                                <i class="fas fa-tag"></i>
                                                                <div>
                                                                    <div class="label">Startup Sector</div>
                                                                    <div class="value" id="studentSector">—</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- MENTOR MODAL -->
                                                    <div class="modal-overlay" id="mentorModal">
                                                        <div class="modal-box">
                                                            <button class="modal-close"
                                                                onclick="closeModal('mentorModal')">✕</button>
                                                            <div class="modal-photo" id="mentorInitials">M</div>
                                                            <div class="modal-name" id="mentorName">—</div>
                                                            <div class="modal-role" id="mentorExpertise">—</div>

                                                            <div class="modal-info">
                                                                <i class="fas fa-envelope"></i>
                                                                <div>
                                                                    <div class="label">Email Address</div>
                                                                    <div class="value" id="mentorEmail">—</div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-info">
                                                                <i class="fas fa-phone"></i>
                                                                <div>
                                                                    <div class="label">Contact Number</div>
                                                                    <div class="value" id="mentorContact">—</div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-info">
                                                                <i class="fas fa-tag"></i>
                                                                <div>
                                                                    <div class="label">Sector</div>
                                                                    <div class="value" id="mentorSector">—</div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-info">
                                                                <i class="fas fa-briefcase"></i>
                                                                <div>
                                                                    <div class="label">Expertise</div>
                                                                    <div class="value" id="mentorExp">—</div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-info">
                                                                <i class="fas fa-info-circle"></i>
                                                                <div>
                                                                    <div class="label">Bio</div>
                                                                    <div class="value" id="mentorBio"
                                                                        style="font-weight:400; line-height:1.6;">—
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <script>
                                                        function getInitials(name) {
                                                            const parts = name.trim().split(' ');
                                                            const a = parts[0] ? parts[0].charAt(0) : '';
                                                            const b = parts[1] ? parts[1].charAt(0) : '';
                                                            return (a + b).toUpperCase() || '?';
                                                        }

                                                        function closeModal(id) {
                                                            document.getElementById(id).classList.remove('active');
                                                        }

                                                        // STUDENT modal (clicked by mentor)
                                                        document.querySelectorAll('.js-student-btn').forEach(function (btn) {
                                                            btn.addEventListener('click', function () {
                                                                document.getElementById('studentName').textContent = this.dataset.name;
                                                                document.getElementById('studentCollege').textContent = this.dataset.college;
                                                                document.getElementById('studentContact').textContent = this.dataset.contact;
                                                                document.getElementById('studentEmail').textContent = this.dataset.email;
                                                                document.getElementById('studentSector').textContent = this.dataset.sector;
                                                                document.getElementById('studentInitials').textContent = getInitials(this.dataset.name);
                                                                document.getElementById('studentModal').classList.add('active');
                                                            });
                                                        });

                                                        // MENTOR modal (clicked by student)
                                                        document.querySelectorAll('.js-mentor-btn').forEach(function (btn) {
                                                            btn.addEventListener('click', function () {
                                                                document.getElementById('mentorName').textContent = this.dataset.name;
                                                                document.getElementById('mentorExpertise').textContent = this.dataset.expertise + ' • ' + this.dataset.experience;
                                                                document.getElementById('mentorEmail').textContent = this.dataset.email;
                                                                document.getElementById('mentorContact').textContent = this.dataset.contact;
                                                                document.getElementById('mentorSector').textContent = this.dataset.sector;
                                                                document.getElementById('mentorExp').textContent = this.dataset.expertise;
                                                                document.getElementById('mentorBio').textContent = this.dataset.bio;
                                                                document.getElementById('mentorInitials').textContent = getInitials(this.dataset.name);
                                                                document.getElementById('mentorModal').classList.add('active');
                                                            });
                                                        });

                                                        // Close on overlay click
                                                        document.querySelectorAll('.modal-overlay').forEach(function (overlay) {
                                                            overlay.addEventListener('click', function (e) {
                                                                if (e.target === this) this.classList.remove('active');
                                                            });
                                                        });
                                                    </script>

</body>

</html>