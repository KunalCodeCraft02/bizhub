<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BizHub Entrepreneurship Test</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap"
        rel="stylesheet">
    <style>
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --brand: #E8541A;
            --brand-light: #ff7b42;
            --bg: #080808;
            --surface: #101010;
            --surface2: #161616;
            --border: #1e1e1e;
            --border2: #282828;
            --text: #f0f0f0;
            --muted: #666;
            --muted2: #888;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 50% at 85% 10%, rgba(232, 84, 26, 0.14) 0%, transparent 60%),
                radial-gradient(ellipse 50% 40% at 10% 85%, rgba(232, 84, 26, 0.08) 0%, transparent 55%);
            pointer-events: none;
            z-index: 0;
        }

        /* ── NAVBAR ── */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px 64px;
            border-bottom: 1px solid var(--border);
            background: rgba(8, 8, 8, 0.9);
            backdrop-filter: blur(16px);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .logo {
            font-family: 'Syne', sans-serif;
            font-size: 26px;
            font-weight: 800;
            color: var(--brand);
            letter-spacing: -0.5px;
        }

        .logo span {
            color: var(--text);
        }

        .timer-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--surface);
            border: 1px solid var(--border2);
            padding: 12px 22px;
            border-radius: 14px;
        }

        .timer-icon {
            color: var(--brand);
            font-size: 18px;
        }

        .timer {
            color: var(--brand);
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 22px;
            letter-spacing: 1px;
            min-width: 58px;
        }

        .timer.warning {
            color: #ff4444;
            animation: blink 1s infinite;
        }

        @keyframes blink {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        /* ── LAYOUT ── */
        .main {
            display: flex;
            gap: 28px;
            padding: 44px 64px;
            position: relative;
            z-index: 1;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 270px;
            flex-shrink: 0;
            position: sticky;
            top: 100px;
            height: fit-content;
        }

        .sidebar-inner {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 28px;
        }

        .sidebar-title {
            font-family: 'Syne', sans-serif;
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .sidebar-desc {
            color: var(--muted2);
            line-height: 1.7;
            font-size: 13.5px;
        }

        .progress-box {
            margin-top: 28px;
            padding: 20px;
            background: var(--surface2);
            border-radius: 16px;
            border: 1px solid var(--border2);
        }

        .progress-label {
            font-size: 12px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 14px;
        }

        .progress-track {
            height: 8px;
            background: #222;
            border-radius: 50px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--brand), var(--brand-light));
            border-radius: 50px;
            transition: width 0.4s cubic-bezier(.4, 0, .2, 1);
        }

        .progress-meta {
            margin-top: 12px;
            font-size: 13px;
            color: var(--muted2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .progress-count {
            color: var(--brand);
            font-weight: 700;
            font-family: 'Syne', sans-serif;
        }

        /* Question dots */
        .dot-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 20px;
        }

        .dot {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: #1a1a1a;
            border: 1px solid var(--border2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            color: var(--muted);
            cursor: pointer;
            transition: 0.2s;
            font-family: 'Syne', sans-serif;
            font-weight: 600;
        }

        .dot.answered {
            background: rgba(232, 84, 26, 0.2);
            border-color: var(--brand);
            color: var(--brand);
        }

        .dot.current {
            background: var(--brand);
            color: white;
            border-color: var(--brand);
        }

        /* ── TEST AREA ── */
        .test-area {
            flex: 1;
            min-width: 0;
        }

        .question-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 26px;
            padding: 48px;
            animation: slideUp 0.35s cubic-bezier(.4, 0, .2, 1);
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .q-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .q-number {
            font-size: 12px;
            font-weight: 600;
            color: var(--brand);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-family: 'Syne', sans-serif;
        }

        .q-score-chip {
            font-size: 12px;
            color: var(--muted2);
            background: var(--surface2);
            border: 1px solid var(--border2);
            padding: 5px 12px;
            border-radius: 30px;
        }

        .q-score-chip span {
            color: var(--brand);
            font-weight: 700;
        }

        .question {
            font-family: 'Syne', sans-serif;
            font-size: 24px;
            line-height: 1.45;
            font-weight: 700;
            margin-bottom: 36px;
            color: #f5f5f5;
        }

        .options {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .option {
            background: var(--surface2);
            border: 1.5px solid var(--border2);
            border-radius: 16px;
            padding: 20px 22px;
            cursor: pointer;
            transition: all 0.22s ease;
            display: flex;
            align-items: flex-start;
            gap: 16px;
        }

        .option:hover {
            border-color: var(--brand);
            background: rgba(232, 84, 26, 0.06);
            transform: translateX(4px);
        }

        .option.selected {
            border-color: var(--brand);
            background: rgba(232, 84, 26, 0.12);
        }

        .option.correct {
            border-color: #22c55e;
            background: rgba(34, 197, 94, 0.1);
        }

        .option.wrong {
            border-color: #ef4444;
            background: rgba(239, 68, 68, 0.08);
        }

        .option-letter {
            min-width: 38px;
            min-height: 38px;
            border-radius: 10px;
            background: #222;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand);
            font-weight: 700;
            font-family: 'Syne', sans-serif;
            font-size: 14px;
            transition: 0.22s;
        }

        .option.selected .option-letter {
            background: var(--brand);
            color: white;
        }

        .option-text {
            line-height: 1.65;
            color: #ccc;
            font-size: 15px;
            padding-top: 2px;
        }

        .bottom {
            display: flex;
            gap: 14px;
            margin-top: 36px;
        }

        .btn {
            padding: 16px 24px;
            border: none;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.22s ease;
            font-family: 'Syne', sans-serif;
            letter-spacing: 0.3px;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn-prev {
            background: var(--surface2);
            color: var(--text);
            border: 1px solid var(--border2);
            flex: 0 0 auto;
        }

        .btn-next {
            background: var(--surface2);
            color: var(--text);
            border: 1px solid var(--border2);
            flex: 1;
        }

        .btn-submit {
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            color: white;
            flex: 1;
            box-shadow: 0 8px 32px rgba(232, 84, 26, 0.28);
        }

        .btn-submit:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
        }

        /* ── RESULT CARD ── */
        .result-card {
            display: none;
            flex-direction: column;
            align-items: center;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 26px;
            padding: 60px 48px;
            text-align: center;
            animation: slideUp 0.5s ease;
        }

        .score-ring-wrap {
            position: relative;
            width: 200px;
            height: 200px;
            margin-bottom: 44px;
        }

        .score-ring-wrap svg {
            position: absolute;
            top: 0;
            left: 0;
            transform: rotate(-90deg);
        }

        .score-ring-bg {
            fill: none;
            stroke: #1e1e1e;
            stroke-width: 10;
        }

        .score-ring-fill {
            fill: none;
            stroke: url(#ringGrad);
            stroke-width: 10;
            stroke-linecap: round;
            stroke-dasharray: 502;
            stroke-dashoffset: 502;
            transition: stroke-dashoffset 1.5s cubic-bezier(.4, 0, .2, 1);
        }

        .score-inner {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .score-number {
            font-family: 'Syne', sans-serif;
            font-size: 48px;
            font-weight: 800;
            color: var(--brand);
            line-height: 1;
        }

        .score-total {
            font-size: 14px;
            color: var(--muted2);
            margin-top: 4px;
        }

        .level-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 28px;
            border-radius: 50px;
            font-family: 'Syne', sans-serif;
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 32px;
        }

        .level-badge.beginner {
            background: rgba(59, 130, 246, 0.15);
            border: 1.5px solid rgba(59, 130, 246, 0.4);
            color: #60a5fa;
        }

        .level-badge.intermediate {
            background: rgba(234, 179, 8, 0.15);
            border: 1.5px solid rgba(234, 179, 8, 0.4);
            color: #facc15;
        }

        .level-badge.advanced {
            background: rgba(34, 197, 94, 0.15);
            border: 1.5px solid rgba(34, 197, 94, 0.4);
            color: #4ade80;
        }

        .result-title {
            font-family: 'Syne', sans-serif;
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .result-desc {
            color: var(--muted2);
            font-size: 15px;
            line-height: 1.7;
            max-width: 520px;
            margin-bottom: 44px;
        }

        .score-breakdown {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            width: 100%;
            max-width: 600px;
            margin-bottom: 36px;
        }

        .breakdown-item {
            background: var(--surface2);
            border: 1px solid var(--border2);
            border-radius: 16px;
            padding: 20px 16px;
        }

        .breakdown-val {
            font-family: 'Syne', sans-serif;
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .breakdown-val.correct {
            color: #4ade80;
        }

        .breakdown-val.wrong {
            color: #f87171;
        }

        .breakdown-val.skipped {
            color: var(--muted2);
        }

        .breakdown-label {
            font-size: 12px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .improvement-box {
            width: 100%;
            max-width: 640px;
            background: var(--surface2);
            border: 1px solid var(--border2);
            border-radius: 20px;
            padding: 30px;
            text-align: left;
            margin-bottom: 32px;
        }

        .improvement-title {
            font-family: 'Syne', sans-serif;
            font-size: 18px;
            font-weight: 800;
            color: var(--brand);
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .improvement-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
            font-size: 14.5px;
            color: #ccc;
            line-height: 1.6;
        }

        .improvement-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .improvement-icon {
            color: var(--brand);
            font-size: 16px;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .threshold-hint {
            font-size: 12px;
            color: var(--muted);
            margin-top: 6px;
            text-align: center;
            padding: 14px 20px;
            background: var(--surface2);
            border-radius: 12px;
            border: 1px solid var(--border);
            width: 100%;
            max-width: 640px;
            line-height: 1.8;
            margin-bottom: 24px;
        }

        .threshold-hint b {
            color: var(--text);
        }

        .btn-restart {
            background: var(--surface2);
            border: 1px solid var(--border2);
            color: var(--text);
            padding: 16px 40px;
            border-radius: 14px;
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-restart:hover {
            border-color: var(--brand);
            color: var(--brand);
        }

        @media(max-width:960px) {
            .main {
                flex-direction: column;
                padding: 28px 20px;
            }

            .sidebar {
                width: 100%;
                position: relative;
                top: 0;
            }

            .navbar {
                padding: 18px 20px;
            }

            .question {
                font-size: 20px;
            }

            .question-card {
                padding: 28px 22px;
            }

            .score-breakdown {
                grid-template-columns: repeat(3, 1fr);
            }
        }
    </style>
</head>

<body>

    <div class="navbar">
        <div class="logo">Biz<span>Hub</span></div>
        <div class="timer-wrap">
            <span class="timer-icon">⏱</span>
            <div class="timer" id="timerDisplay">20:00</div>
        </div>
    </div>

    <div class="main">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-title">Pre-Training Test</div>
                <div class="sidebar-desc">Complete this entrepreneurship assessment. Answer at least 15 questions to
                    submit. Your level is determined by your score.</div>

                <div class="progress-box">
                    <div class="progress-label">Progress</div>
                    <div class="progress-track">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                    <div class="progress-meta">
                        <span id="progressText">0 / 15 required</span>
                        <span class="progress-count" id="progressPct">0%</span>
                    </div>
                </div>

                <div class="dot-grid" id="dotGrid"></div>
            </div>
        </div>

        <!-- TEST AREA -->
        <div class="test-area">
            <div class="question-card" id="questionCard">
                <div class="q-header">
                    <div class="q-number" id="questionNo">Question 1 of 20</div>
                    <div class="q-score-chip">Score: <span id="liveScore">0</span>/20</div>
                </div>
                <div class="question" id="questionText"></div>
                <div class="options" id="optionsContainer"></div>
                <div class="bottom">
                    <button class="btn btn-prev" onclick="prevQuestion()">← Prev</button>
                    <button class="btn btn-next" onclick="nextQuestion()">Next →</button>
                    <button class="btn btn-submit" id="submitBtn" onclick="validateAndSubmit()" disabled>Submit
                        Test</button>
                </div>
            </div>

            <!-- RESULT -->
            <div class="result-card" id="resultCard">
                <div class="score-ring-wrap">
                    <svg width="200" height="200" viewBox="0 0 200 200">
                        <defs>
                            <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#E8541A" />
                                <stop offset="100%" stop-color="#ff7b42" />
                            </linearGradient>
                        </defs>
                        <circle class="score-ring-bg" cx="100" cy="100" r="80" />
                        <circle class="score-ring-fill" id="ringFill" cx="100" cy="100" r="80" />
                    </svg>
                    <div class="score-inner">
                        <div class="score-number" id="finalScore">0</div>
                        <div class="score-total">out of 20</div>
                    </div>
                </div>

                <div class="level-badge" id="levelBadge">–</div>
                <div class="result-title" id="resultTitle">Evaluating...</div>
                <div class="result-desc" id="resultDesc"></div>

                <div class="score-breakdown">
                    <div class="breakdown-item">
                        <div class="breakdown-val correct" id="bdCorrect">0</div>
                        <div class="breakdown-label">Correct</div>
                    </div>
                    <div class="breakdown-item">
                        <div class="breakdown-val wrong" id="bdWrong">0</div>
                        <div class="breakdown-label">Wrong</div>
                    </div>
                    <div class="breakdown-item">
                        <div class="breakdown-val skipped" id="bdSkipped">0</div>
                        <div class="breakdown-label">Skipped</div>
                    </div>
                </div>

                <div class="threshold-hint">
                    <b>Scoring Key:</b> &nbsp; 🟢 16–20 = Advanced &nbsp;|&nbsp; 🟡 12–15 = Intermediate &nbsp;|&nbsp;
                    🔵 0–11 = Beginner
                </div>

                <div class="improvement-box">
                    <div class="improvement-title">📈 Focus Areas for You</div>
                    <div id="improvementList"></div>
                </div>

                <button class="btn-restart" id="startCourseBtn" disabled>Saving Result...</button>
            </div>
        </div>
    </div>

    <script>
        // ── QUESTIONS + CORRECT ANSWERS ──────────────────────────────────────────────
        const questions = [
            {
                question: "The school canteen is always crowded during the 15-minute break, and many students miss out on food. What is the most entrepreneurial way to help?",
                options: [
                    "Suggest the canteen hire more staff to work faster.",
                    "Eat your lunch during class time so you don't have to queue.",
                    "Propose a Pre-order system where students write their orders before break starts.",
                    "Complain to the principal that the break time is too short."
                ],
                correct: "Propose a Pre-order system where students write their orders before break starts."
            },

            {
                question: "Your team just lost a school competition because of a mistake you made in the final presentation. Your team members are upset and blaming each other. What is your first move?",
                options: [
                    "Explain that it was a team effort and everyone made mistakes.",
                    "Publicly admit it was your mistake and apologize.",
                    "Stay quiet and let things cool down.",
                    "Blame others for not working harder."
                ],
                correct: "Publicly admit it was your mistake and apologize."
            },

            {
                question: "You found a way to finish a team task in 10 minutes instead of 2 hours using a shortcut that is slightly against the rules. What do you do?",
                options: [
                    "Use the shortcut.",
                    "Ask the team to vote.",
                    "Follow the rules and complete properly.",
                    "Report the shortcut to change rules."
                ],
                correct: "Report the shortcut to change rules."
            },

            {
                question: "A customer at your school bake sale accidentally gives you ₹500 instead of ₹100. What do you do?",
                options: [
                    "Keep the money.",
                    "Put extra money into charity.",
                    "Return the extra money immediately.",
                    "Wait and see if they return."
                ],
                correct: "Return the extra money immediately."
            },

            {
                question: "You have a major exam on Monday and your E-cell event on Sunday. You are the lead organizer. What do you do?",
                options: [
                    "Cancel the event.",
                    "Stay awake all night.",
                    "Train a junior member to handle it.",
                    "Do both without planning."
                ],
                correct: "Train a junior member to handle it."
            },

            {
                question: "Your team has only one laptop for a presentation. Everyone wants to use it. What do you do?",
                options: [
                    "Keep it yourself.",
                    "Create a rotation schedule.",
                    "Tell everyone to work separately.",
                    "Use pen and paper only."
                ],
                correct: "Create a rotation schedule."
            },

            {
                question: "You are selling handmade bookmarks for ₹30. A competitor starts selling at ₹20. What is your move?",
                options: [
                    "Reduce price to ₹15.",
                    "Say their quality is poor.",
                    "Offer personalization or combo deals.",
                    "Stop selling."
                ],
                correct: "Offer personalization or combo deals."
            },

            {
                question: "You made handmade keychains and kept price ₹50. Many students liked it but said it is expensive. What will you do?",
                options: [
                    "Reduce price to ₹30",
                    "Add better packaging and explain value",
                    "Give combo offer like 2 for ₹80",
                    "Tell them then don't buy"
                ],
                correct: "Give combo offer like 2 for ₹80"
            },

            {
                question: "You are selling handmade greeting cards. Some students love them but only a few buy. What is your best step?",
                options: [
                    "Stop selling",
                    "Give bulk discount",
                    "Ask customers to post on Instagram",
                    "Create cards for events"
                ],
                correct: "Create cards for events"
            },

            {
                question: "You made a product and your first 5 customers are happy. What is the smartest next step?",
                options: [
                    "Increase price",
                    "Ask for feedback",
                    "Ask for referrals",
                    "Produce more units"
                ],
                correct: "Ask for referrals"
            },

            {
                question: "Your customer complains publicly in front of others. What do you do?",
                options: [
                    "Argue back",
                    "Stay calm and solve it",
                    "Offer replacement",
                    "Talk later privately"
                ],
                correct: "Stay calm and solve it"
            },

            {
                question: "You are selling a product. Someone asks you: “Why should I buy from you?” What will you do? ",
                options: [
                    "Say it is good",
                    "Explain benefits and quality",
                    "Show reviews",
                    "Offer sample"
                ],
                correct: "Explain benefits and quality"
            },

            {
                question: "You started a business with friends but everyone wants to become leader. What do you do?",
                options: [
                    "Fight for leadership",
                    "Divide roles clearly",
                    "Vote for leader",
                    "Rotate leadership"
                ],
                correct: "Divide roles clearly"
            },

            {
                question: "You posted your product on Instagram but got only 5 views. What do you do?",
                options: [
                    "Delete post",
                    "Use better caption",
                    "Ask friends to share",
                    "Make a reel"
                ],
                correct: "Make a reel"
            },

            {
                question: "You are selling notes and a student says they can get notes free online. What do you reply?",
                options: [
                    "Then don't buy",
                    "Explain notes are simplified",
                    "Offer sample",
                    "Add extra value"
                ],
                correct: "Offer sample"
            },

            {
                question: "Your product is trending and demand is high. What will you do?",
                options: [
                    "Increase price",
                    "Increase production",
                    "Maintain quality",
                    "Hire help"
                ],
                correct: "Maintain quality"
            },

            {
                question: "You have two business ideas: low profit but easy and high profit but risky. What do you do?",
                options: [
                    "Choose easy",
                    "Choose risky",
                    "Test both",
                    "Ask customers"
                ],
                correct: "Test both"
            },

            {
                question: "You are selling handmade candles. Some candles melt in heat. What do you do?",
                options: [
                    "Stop summer sales",
                    "Improve packaging",
                    "Change material formula",
                    "Add storage instructions"
                ],
                correct: "Change material formula"
            },

            {
                question: "You find a box of 100 mismatched, colorful socks in the school attic. The Principal says you can have them for free. How do you use them to raise the most money for the school's sports team?",
                options: [
                    "Sell emergency socks",
                    "Give to drama club",
                    "Make sock puppets and host a show",
                    "Find matching pairs"
                ],
                correct: "Make sock puppets and host a show"
            },

            {
                question: "The back of the school’s weekly ID card holder is blank white plastic. You see thousands of students wearing them every day. What is your first thought?",
                options: [
                    "Write names there",
                    "Sell ad space to local shops",
                    "Reduce plastic usage",
                    "Draw doodles"
                ],
                correct: "Sell ad space to local shops"
            }
        ];
        // ── STATE ────────────────────────────────────────────────────────────────────
        let currentQuestion = 0;
        let answers = {};
        let timeLeft = 1200;
        let submittedOnce = false;

        // ── TIMER ────────────────────────────────────────────────────────────────────
        const timerEl = document.getElementById("timerDisplay");
        const timerInterval = setInterval(() => {
            timeLeft--;
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            timerEl.innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
            if (timeLeft <= 60) timerEl.classList.add("warning");
            if (timeLeft <= 0) { clearInterval(timerInterval); submitTest(); }
        }, 1000);

        // ── DOT GRID ─────────────────────────────────────────────────────────────────
        function buildDots() {
            const grid = document.getElementById("dotGrid");
            grid.innerHTML = "";
            questions.forEach((_, i) => {
                const dot = document.createElement("div");
                dot.className = "dot" + (answers[i] !== undefined ? " answered" : "") + (i === currentQuestion ? " current" : "");
                dot.innerText = i + 1;
                dot.onclick = () => { currentQuestion = i; renderQuestion(); };
                grid.appendChild(dot);
            });
        }

        // ── PROGRESS ─────────────────────────────────────────────────────────────────
        function updateProgress() {
            const count = Object.keys(answers).length;
            const pct = Math.min((count / 15) * 100, 100);
            document.getElementById("progressFill").style.width = pct + "%";
            document.getElementById("progressText").innerText = `${count} / 15 required`;
            document.getElementById("progressPct").innerText = Math.round(pct) + "%";

            // live score
            let score = 0;
            Object.entries(answers).forEach(([idx, ans]) => {
                if (questions[idx].correct === ans) score++;
            });
            document.getElementById("liveScore").innerText = score;

            // enable submit
            const submitBtn = document.getElementById("submitBtn");
            submitBtn.disabled = count < 15;
        }

        // ── RENDER QUESTION ───────────────────────────────────────────────────────────
        function renderQuestion() {
            const q = questions[currentQuestion];
            document.getElementById("questionNo").innerText = `Question ${currentQuestion + 1} of ${questions.length}`;
            document.getElementById("questionText").innerText = q.question;

            const container = document.getElementById("optionsContainer");
            container.innerHTML = "";

            q.options.forEach((option, index) => {
                const div = document.createElement("div");
                div.className = "option" + (answers[currentQuestion] === option ? " selected" : "");
                div.innerHTML = `
            <div class="option-letter">${String.fromCharCode(65 + index)}</div>
            <div class="option-text">${option}</div>
        `;
                div.onclick = () => {
                    answers[currentQuestion] = option;
                    updateProgress();
                    buildDots();
                    renderQuestion();
                };
                container.appendChild(div);
            });

            buildDots();
            updateProgress();
        }

        // ── NAVIGATION ────────────────────────────────────────────────────────────────
        function nextQuestion() {
            if (currentQuestion < questions.length - 1) { currentQuestion++; renderQuestion(); }
        }
        function prevQuestion() {
            if (currentQuestion > 0) { currentQuestion--; renderQuestion(); }
        }

        // ── VALIDATE & SUBMIT ─────────────────────────────────────────────────────────
        function validateAndSubmit() {
            const count = Object.keys(answers).length;
            if (count < 15) {
                alert("Please answer at least 15 questions before submitting.");
                return;
            }
            submitTest();
        }

        // ── SUBMIT + SCORE ────────────────────────────────────────────────────────────
        function submitTest() {
            if (submittedOnce) return;
            submittedOnce = true;

            clearInterval(timerInterval);

            // Calculate score
            let correct = 0;

            Object.entries(answers).forEach(([idx, ans]) => {
                if (questions[parseInt(idx)].correct === ans) {
                    correct++;
                }
            });

            const answered = Object.keys(answers).length;
            const wrong = answered - correct;
            const skipped = questions.length - answered;

            let level, levelClass, title, desc, improvements;

            if (correct >= 16) {
                level = "Advanced";
                levelClass = "advanced";
                title = "Exceptional Entrepreneurial Thinking!";
                desc = "You demonstrate strong strategic instincts, ethical grounding, and sound business judgment. You're ready for advanced training in scaling, leadership, and investor relations.";
                improvements = [
                    { icon: "📊", text: "Optimize your unit economics and understand key financial metrics like CAC, LTV, and burn rate." },
                    { icon: "🤝", text: "Focus on investor readiness — build a compelling pitch deck and understand term sheets." },
                    { icon: "👥", text: "Develop leadership teams and master delegation to scale beyond yourself." },
                    { icon: "🌐", text: "Explore market expansion strategies including partnerships, licensing, and international growth." }
                ];
            } else if (correct >= 12) {
                level = "Intermediate";
                levelClass = "intermediate";
                title = "Solid Business Instincts!";
                desc = "You have a good foundation in entrepreneurship and make sound decisions most of the time. With focused learning in a few key areas, you'll reach the advanced tier quickly.";
                improvements = [
                    { icon: "⚙️", text: "Automate customer feedback loops — use surveys, NPS scoring, and review tracking." },
                    { icon: "🔍", text: "Deep-dive into competitive analysis: understand Porter's Five Forces and SWOT." },
                    { icon: "📈", text: "Learn to scale operations efficiently — systems, SOPs, and lean methodology." },
                    { icon: "💬", text: "Sharpen your sales pitch: practice value propositions and handling objections." }
                ];
            } else {
                level = "Beginner";
                levelClass = "beginner";
                title = "Your Entrepreneurial Journey Starts Here!";
                desc = "You're at the beginning of a fantastic journey. Every expert was once a beginner. Focus on building core foundations and you'll progress rapidly through the levels.";
                improvements = [
                    { icon: "🔬", text: "Learn market research fundamentals — customer interviews, surveys, and competitor mapping." },
                    { icon: "💰", text: "Master basic financial literacy: revenue, costs, profit margins, and simple budgeting." },
                    { icon: "🎯", text: "Understand value propositions — what makes a product worth buying and how to communicate it." },
                    { icon: "🤲", text: "Study ethical decision-making in business — integrity builds long-term brand trust." }
                ];
            }

            // Show result
            document.getElementById("questionCard").style.display = "none";

            const resultCard = document.getElementById("resultCard");
            resultCard.style.display = "flex";

            // Populate result
            document.getElementById("finalScore").innerText = correct;
            document.getElementById("bdCorrect").innerText = correct;
            document.getElementById("bdWrong").innerText = wrong;
            document.getElementById("bdSkipped").innerText = skipped;
            document.getElementById("resultTitle").innerText = title;
            document.getElementById("resultDesc").innerText = desc;

            const badge = document.getElementById("levelBadge");
            badge.innerText = "⭐ " + level;
            badge.className = "level-badge " + levelClass;

            const list = document.getElementById("improvementList");
            list.innerHTML = improvements.map(item =>
                `<div class="improvement-item">
            <span class="improvement-icon">${item.icon}</span>
            <span>${item.text}</span>
        </div>`
            ).join("");

            // Animate ring
            setTimeout(() => {
                const circumference = 2 * Math.PI * 80;
                const offset = circumference - (correct / 20) * circumference;
                document.getElementById("ringFill").style.strokeDashoffset = offset;
            }, 200);

            // Save result in database
            savePretestResult({
                level,
                correct,
                answered,
                wrong,
                skipped
            });
        }
        async function savePretestResult(payload) {
            const btn = document.getElementById("startCourseBtn");

            btn.disabled = true;
            btn.innerText = "Saving Result...";

            try {
                const response = await fetch("/save-level", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.message || "Could not save result");
                }

                btn.disabled = false;
                btn.innerText = `Start Course as ${data.level || payload.level} →`;

                btn.onclick = () => {
                    window.location.href = "/courseplayer";
                };

            } catch (error) {
                console.error(error);

                btn.disabled = false;
                btn.innerText = "Retry Saving Result";

                btn.onclick = () => {
                    savePretestResult(payload);
                };

                alert("Your result was calculated, but saving failed. Please click Retry Saving Result.");
            }
        }
        renderQuestion();
    </script>
</body>

</html>