<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>School Admin Sign Up</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">

  <style>
    /* (Your existing styles remain the same - I kept them clean) */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Outfit', sans-serif;
    }

    body {
      background: #0a0a0a;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
    }

    .card {
      width: 90%;
      max-width: 460px;
      background: #111;
      padding: 32px 26px;
      border-radius: 16px;
    }

    .icon {
      text-align: center;
      font-size: 26px;
      margin-bottom: 6px;
    }

    h1 {
      text-align: center;
      font-size: 26px;
      font-weight: 600;
    }

    .subtitle {
      text-align: center;
      color: #888;
      font-size: 13px;
      margin-bottom: 22px;
    }

    .form-group {
      margin-bottom: 16px;
      position: relative;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-size: 13px;
      font-weight: 500;
    }

    input {
      width: 100%;
      padding: 14px 16px;
      border-radius: 10px;
      background: #1a1a1a;
      border: 1px solid #222;
      color: white;
      font-size: 14px;
      outline: none;
    }

    input::placeholder {
      color: #777;
    }

    .password-wrapper {
      position: relative;
    }

    .toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      font-size: 14px;
      color: #777;
    }

    .toggle.active {
      color: #E8541A;
    }

    .error {
      color: #ff4d4d;
      font-size: 12px;
      margin-top: 4px;
      display: none;
    }

    button {
      width: 100%;
      padding: 14px;
      border-radius: 10px;
      border: none;
      background: linear-gradient(135deg, #E8541A, #C94A0F);
      color: white;
      font-weight: 600;
      cursor: pointer;
      margin-top: 10px;
      transition: 0.25s;
    }

    button:hover {
      transform: scale(1.02);
      box-shadow: 0 0 18px rgba(232, 84, 26, 0.6);
    }

    .bottom-text {
      text-align: center;
      font-size: 13px;
      color: #888;
      margin-top: 16px;
    }

    .bottom-text a {
      color: #E8541A;
      text-decoration: none;
    }
  </style>
</head>

<body>
  <div class="card">
    <div class="icon">🏫</div>
    <h1>Sign Up as School Admin</h1>
    <div class="subtitle">Register your school to get started</div>

    <% if (typeof query !=='undefined' && query && query.error) { %>
      <script>alert("<%= query.error %>");</script>
      <% } %>

        <form id="schoolForm" action="/schoolsignup" method="post">
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" name="email" id="email" placeholder="Enter your school email" required>
            <div class="error" id="emailError">Invalid email</div>
          </div>

          <div class="form-group">
            <label>School Name</label>
            <input type="text" name="schoolName" id="schoolName" required>
            <div class="error" id="schoolError">School name is required</div>
          </div>

          <div class="form-group">
            <label>Establishment Year</label>
            <input type="number" name="establishmentYear" id="year" placeholder="e.g. 1995" required>
            <div class="error" id="yearError">Invalid year</div>
          </div>

          <div class="form-group password-wrapper">
            <label>Password</label>
            <input type="password" name="password" id="password" placeholder="Create a strong password" required>
            <span class="toggle" onclick="togglePassword('password', this)">👁</span>
            <div class="error" id="passwordError">Password must contain uppercase, number & special character (min 8)
            </div>
          </div>

          <div class="form-group password-wrapper">
            <label>Confirm Password</label>
            <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Re-enter your password"
              required>
            <span class="toggle" onclick="togglePassword('confirmPassword', this)">👁</span>
            <div class="error" id="confirmError">Passwords do not match</div>
          </div>

          <button type="submit">Register School</button>
        </form>

        <div class="bottom-text">
          Already registered? <a href="/schoollogin">Sign in here</a>
        </div>
  </div>

  <script>
    const form = document.getElementById('schoolForm');

    form.addEventListener('submit', function (e) {
      let valid = true;
      const currentYear = new Date().getFullYear();

      const email = document.getElementById('email').value.trim();
      const schoolName = document.getElementById('schoolName').value.trim();
      const year = parseInt(document.getElementById('year').value);
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      // Reset previous errors
      document.querySelectorAll('.error').forEach(el => el.style.display = 'none');

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        document.getElementById('emailError').style.display = 'block';
        valid = false;
      }
      if (schoolName === '') {
        document.getElementById('schoolError').style.display = 'block';
        valid = false;
      }
      if (!year || year < 1800 || year > currentYear) {
        document.getElementById('yearError').style.display = 'block';
        valid = false;
      }
      if (!/^(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/.test(password)) {
        document.getElementById('passwordError').style.display = 'block';
        valid = false;
      }
      if (password !== confirmPassword) {
        document.getElementById('confirmError').style.display = 'block';
        valid = false;
      }


      if (!valid) {
        e.preventDefault();

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          alert("Please enter a valid email address");
        }
        else if (!year || year < 1800 || year > currentYear) {
          alert("Please enter a valid establishment year");
        }
        else if (!/^(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/.test(password)) {
          alert("Password must contain uppercase letter, number and special character");
        }
        else if (password !== confirmPassword) {
          alert("Passwords do not match");
        }
      }
    });

    function togglePassword(id, el) {
      const input = document.getElementById(id);
      if (input.type === "password") {
        input.type = "text";
        el.classList.add('active');
      } else {
        input.type = "password";
        el.classList.remove('active');
      }
    }
  </script>
</body>

</html>