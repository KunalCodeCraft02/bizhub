<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>School Performance Track | Bizhub</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        /* Shared Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: #0a0a0a;
            color: white;
            padding: 40px;
        }

        .grid-kpi {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .kpi-card {
            background: #111;
            padding: 24px;
            border-radius: 15px;
            border: 1px solid #222;
        }

        .kpi-card h3 {
            color: #888;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .kpi-card p {
            font-size: 32px;
            font-weight: 800;
            color: #E8541A;
        }

        .chart-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 40px;
        }

        .chart-box {
            background: #111;
            padding: 24px;
            border-radius: 15px;
            border: 1px solid #222;
        }

        .table-section {
            background: #111;
            padding: 24px;
            border-radius: 15px;
            border: 1px solid #222;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th {
            text-align: left;
            color: #666;
            padding: 12px;
            border-bottom: 1px solid #222;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid #1a1a1a;
        }

        .btn-export {
            background: #E8541A;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .banner {
            text-align: center;
            padding: 100px;
        }
    </style>
</head>

<body>

    <% if(status==='pending' ) { %>
        <div class="banner">
            <h1>⏳ Application Under Review</h1>
            <p>Your institutional access is being verified by Bizhub Admins.</p>
        </div>
        <% } else if(status==='rejected' ) { %>
            <div class="banner">
                <h1 style="color:red">🚫 Unauthorized Access</h1>
                <p>Your application was rejected. Please signup with official school email only.</p>
            </div>
            <% } else { %>

                <h1>Welcome, Administrators of <%= school.schoolName %>
                </h1>

                <!-- KPI Row -->
                <div class="grid-kpi">
                    <div class="kpi-card">
                        <h3>Total Innovators</h3>
                        <p>
                            <%= stats.totalStudents %>
                        </p>
                    </div>
                    <div class="kpi-card">
                        <h3>Course Progress</h3>
                        <p>
                            <%= stats.avgProgress %>%
                        </p>
                    </div>
                    <div class="kpi-card">
                        <h3>Avg Score</h3>
                        <p>
                            <%= stats.avgScore %>
                        </p>
                    </div>
                    <div class="kpi-card">
                        <h3>Learning Hours</h3>
                        <p>
                            <%= stats.totalHours %>
                        </p>
                    </div>
                </div>

                <div class="chart-container">
                    <div class="chart-box">
                        <canvas id="levelChart"></canvas>
                    </div>
                    <div class="chart-box">
                        <canvas id="frictionChart"></canvas>
                    </div>
                </div>

                <div class="chart-box" style="margin-bottom:40px">
                    <canvas id="sectorChart"></canvas>
                </div>

                <div class="table-section">
                    <div style="display:flex; justify-content:space-between; align-items:center">
                        <h2>School Toppers</h2>
                        <button class="btn-export" onclick="window.print()">Export for Competitions</button>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Name</th>
                                <th>Points</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% toppers.forEach((s, i)=> { %>
                                <tr>
                                    <td>#<%= i+1 %>
                                    </td>
                                    <td>
                                        <%= s.firstName %>
                                            <%= s.lastName %>
                                    </td>
                                    <td>
                                        <%= s.totalTestScore %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>

                <script>
                    // Level Pie Chart
                    new Chart(document.getElementById('levelChart'), {
                        type: 'pie',
                        data: {
                            labels: ['Beginner', 'Intermediate', 'Advanced'],
                            datasets: [{
                                data: [<%= levels.Beginner %>, <%= levels.Intermediate %>, <%= levels.Advanced %>],
                                backgroundColor: ['#E8541A', '#C94A0F', '#666']
                            }]
                        },
                        options: { plugins: { title: { display: true, text: 'Academic Level Distribution', color: 'white' } } }
                    });

                    // Friction Bar Chart
                    new Chart(document.getElementById('frictionChart'), {
                        type: 'bar',
                        data: {
                            labels: ['M1', 'M2', 'M3'],
                            datasets: [{
                                label: 'Avg Attempts',
                                data: [<%= friction.M1 %>, <%= friction.M2 %>, <%= friction.M3 %>],
                                backgroundColor: '#E8541A'
                            }]
                        }
                    });

                    // Sector Chart
                    new Chart(document.getElementById('sectorChart'), {
                        type: 'bar',
                        indexAxis: 'y',
                        data: {
                            labels: <% - JSON.stringify(Object.keys(sectors)) %>,
                            datasets: [{
                                label: 'Students Interest',
                                data: <% - JSON.stringify(Object.values(sectors)) %>,
                                backgroundColor: '#E8541A'
                            }]
                        }
                    });
                </script>

                <% } %>
</body>

</html>